# Loomy API — F0. Salin ke .env, JANGAN commit .env.
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=loomy
DB_PASSWORD=ganti-dengan-password-aman
DB_NAME=loomy

# Minimal 32 karakter acak. Contoh: openssl rand -hex 32
JWT_ACCESS_SECRET=ganti-minimal-32-karakter-akses-secret-xxxx
JWT_REFRESH_SECRET=ganti-minimal-32-karakter-refresh-secret-xxxx

# Hanya untuk script seed awal (F0). Tidak dipakai aplikasi saat runtime.
SEED_ADMIN_EMAIL=admin@loomy.local
SEED_ADMIN_PASSWORD=ganti-minimal-12-karakter
